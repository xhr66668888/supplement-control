PORT=3000
DB_PATH=./data/supplement-control.db

# DeepSeek API
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# MIMO Vision API
MIMO_API_KEY=your-mimo-api-key
MIMO_BASE_URL=https://api.mimo.com/v1
# Development only. When false/unset, OCR failures never import mock supplements.
ALLOW_MOCK_OCR=false

# Upload directory for supplement images
UPLOAD_DIR=./uploads
